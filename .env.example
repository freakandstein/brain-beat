# Copy this file to .env (git-ignored) and fill in your own values.
# A real environment variable with the same name overrides the value here.

# OBS WebSocket password (OBS -> Tools -> WebSocket Server Settings).
# Leave empty if authentication is turned off in OBS.
OBS_PASSWORD=

# ntfy topic used by Smart Comment and notify.py. On the public ntfy.sh server
# the topic name is the only secret: anyone who knows it can read and post to
# it, so use a long random one, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(16))"
# Leave empty to disable sending.
NTFY_TOPIC=
